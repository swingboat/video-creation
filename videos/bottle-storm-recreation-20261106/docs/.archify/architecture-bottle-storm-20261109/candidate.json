  "cards": [
    {
      "dot": "cyan",
      "title": "模型与场景",
      "items": [
        "模型提供几何形状；Object 保存位置 旋转和缩放。",
        "材质绑定到几何；灯光和相机决定画面中的外观。"
      ]
    },
    {
      "dot": "emerald",
      "title": "动作关联",
      "items": [
        "小兔脚步与抓握使用世界坐标接触点和双段 IK。",
        "鱼的路径控制整体运动，形态关键帧控制摆尾。",
        "船体姿态与水面共用同一组波浪高度。"
      ]
    },
    {
      "dot": "amber",
      "title": "文件与时间",
      "items": [
        "Blender 使用第 1 到 480 帧，时间为 (frame−1)/24。",
        "Remotion 使用第 0 到 479 帧，画面与音轨在同一时间轴合成。",
        "节点来源链接固定到本项目制作代码提交。"
      ]
    }
  ]
