{
  "version": "1.0.0",
  "private": true,
  "name": "seaside-skate",
  "description": "Independent Remotion project: SeasideSkate",
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "@remotion/media": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "node scripts/remotion.mjs studio src/index.ts --no-open --port=3214",
    "compositions": "node scripts/remotion.mjs compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/remotion.mjs render src/index.ts SeasideSkate outputs/seaside-skate.mp4 --codec=h264 --audio-codec=aac --pixel-format=yuv420p --concurrency=2",
    "still": "node scripts/remotion.mjs still src/index.ts SeasideSkate outputs/checks/current.png --frame=165",
    "check": "npm run typecheck && node scripts/check-isolation.mjs",
    "pack": "python3 scripts/package-project.py",
    "prepare:audio": "python3 scripts/create-seaside-audio.py",
    "verify": "node scripts/verify-media.mjs"
  }
}
