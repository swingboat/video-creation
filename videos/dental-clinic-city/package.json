{
  "version": "1.0.0",
  "private": true,
  "name": "dental-clinic-city",
  "description": "Independent Remotion project: DentalClinicCity",
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@react-three/fiber": "9.8.1",
    "@remotion/three": "4.0.534",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "@types/three": "0.186.0"
  },
  "scripts": {
    "dev": "node scripts/remotion.mjs studio src/index.ts --no-open --port=3215",
    "compositions": "node scripts/remotion.mjs compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/remotion.mjs render src/index.ts DentalClinicCity outputs/dental-clinic-city.mp4 --codec=h264 --audio-codec=aac --pixel-format=yuv420p --concurrency=2 --gl=angle",
    "still": "node scripts/remotion.mjs still src/index.ts DentalClinicCity outputs/checks/current.png --frame=600 --gl=angle",
    "check": "npm run typecheck && node scripts/check-isolation.mjs",
    "pack": "python3 scripts/package-project.py",
    "check:clinic": "npm run typecheck && node scripts/check-clinic.mjs",
    "verify": "node scripts/verify-media.mjs"
  }
}
