{
  "name": "huggingface-get-started",
  "version": "1.0.0",
  "description": "中文 Hugging Face 零基础网站操作介绍动画",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/captions": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "bash scripts/env.sh remotion studio src/index.ts --port=3016",
    "check": "bash scripts/env.sh tsc --noEmit",
    "build": "bash scripts/env.sh remotion bundle src/index.ts outputs/bundle",
    "render": "bash scripts/env.sh remotion render src/index.ts HuggingFaceGuide outputs/huggingface-guide-zh.mp4 --codec=h264 --crf=18 --concurrency=4",
    "stills": "bash scripts/env.sh node scripts/render-checks.mjs",
    "audit-paths": "node scripts/audit-paths.mjs"
  }
}
